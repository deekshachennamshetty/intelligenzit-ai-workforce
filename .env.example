ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM provider selection: "ollama" (default, local) or "anthropic"
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
ANTHROPIC_MODEL=claude-sonnet-4-6

# Authentication (local accounts; roles: admin, operator, viewer)
# First run only: if no users exist, this administrator is created at startup.
# Afterwards manage users in the UI (Users page) or with:
#   python -m backend.auth create-user --username <name> --role admin
# INTELLIGENZIT_ADMIN_USERNAME=
# INTELLIGENZIT_ADMIN_PASSWORD=
# Session lifetime in hours (default 12)
# INTELLIGENZIT_SESSION_HOURS=12
# Local development ONLY: turn enforcement off entirely (never in a shared deployment)
# INTELLIGENZIT_AUTH_DISABLED=1
